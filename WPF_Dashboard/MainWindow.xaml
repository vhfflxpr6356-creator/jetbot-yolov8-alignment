<Window x:Class="SmartTrafficDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 스마트 교통 신호 시스템"
        Width="1440" Height="810"
        MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#DFE1E3"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="Bg" Color="#DFE1E3"/>
        <SolidColorBrush x:Key="Panel" Color="#F4F4F2"/>
        <SolidColorBrush x:Key="Panel2" Color="#ECEDEB"/>
        <SolidColorBrush x:Key="Line" Color="#BFC3C6"/>
        <SolidColorBrush x:Key="Text1" Color="#20252A"/>
        <SolidColorBrush x:Key="Text2" Color="#666D73"/>
        <SolidColorBrush x:Key="Dark" Color="#263039"/>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Resources>


    <Grid Background="{StaticResource Bg}">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="18"/>
        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Border Grid.Row="0"
                Background="#ECEDEB"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="AI SMART TRAFFIC CONTROL"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource Text1}"/>

                    <TextBlock Text="지능형 CCTV 기반 교통 신호 관제 시스템"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Text2}"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Padding="10,5"
                            Background="#E4E6E3"
                            BorderBrush="#BFC3C0"
                            BorderThickness="1"
                            CornerRadius="2"
                            Margin="0,0,14,0">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="7"
                            Height="7"
                            Fill="{Binding SystemStatusColor}"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding SystemStatus}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Dark}"/>

                        </StackPanel>

                    </Border>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="{Binding CurrentTime}"
               HorizontalAlignment="Right"
               FontSize="15"
               FontWeight="SemiBold"
               Foreground="{StaticResource Text1}"/>

                        <TextBlock Text="LOCAL TIME"
               HorizontalAlignment="Right"
               Margin="0,2,0,0"
               FontSize="9"
               Foreground="{StaticResource Text2}"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>



        <!-- ================= MAIN AREA ================= -->

        <Grid Grid.Row="1"
              Margin="22,16,22,14">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.85*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>



            <!-- ================= CCTV PANEL ================= -->

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="32"/>

                    </Grid.RowDefinitions>


                    <!-- CCTV HEADER -->

                    <Border Grid.Row="0"
                            Background="{StaticResource Panel2}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,0,0,1">

                        <Grid Margin="15,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <TextBlock Text="LIVE CCTV"
                                           Style="{StaticResource TitleText}"/>

                                <TextBlock Text="  /  CAMERA 01"
                                           Margin="4,0,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Text2}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{Binding CameraStatusColor}"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding CameraStatus}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text2}"/>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- ================= CCTV IMAGE + ROI ================= -->

                    <Border Grid.Row="1"
                            Margin="13"
                            Background="#1B1E21"
                            BorderBrush="#4C5155"
                            BorderThickness="1">

                        <Grid ClipToBounds="True">


                            <!-- CAMERA IMAGE -->

                            <Image x:Name="CameraImage"
                                   Source="{Binding CameraFrame}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>


                            <!-- ROI DRAWING CANVAS -->

                            <Canvas x:Name="RoiCanvas"
                                    Background="Transparent"
                                    Cursor="Cross"
                                    MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                    MouseMove="RoiCanvas_MouseMove"
                                    MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp"/>


                            <!-- CAMERA LABEL -->

                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="11"
                                    Padding="8,4"
                                    Background="#74262A2E"
                                    BorderBrush="#62676B"
                                    BorderThickness="1"
                                    IsHitTestVisible="False">

                                <TextBlock Text="CAM 01"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#E1E4E6"/>

                            </Border>


                        </Grid>

                    </Border>



                    <!-- CCTV STATUS -->

                    <Border Grid.Row="2"
                            Background="{StaticResource Panel2}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0">

                        <Grid Margin="13,0">

                            <TextBlock Text="영상 입력 상태"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{StaticResource Text2}"/>

                            <TextBlock Text="{Binding VideoInputStatus}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text2}"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>



            <!-- ================= RIGHT PANEL ================= -->

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>

                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="1.35*"/>

                </Grid.RowDefinitions>



                <!-- TRAFFIC STATUS -->

                <Border Grid.Row="0"
                        Style="{StaticResource PanelBorder}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Border Background="{StaticResource Panel2}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1">

                            <TextBlock Text="TRAFFIC STATUS"
                                       Margin="15,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TitleText}"/>

                        </Border>



                        <Grid Grid.Row="1"
                              Margin="16,12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="1*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="차량 수"
                                           Style="{StaticResource LabelText}"/>


                                <StackPanel Orientation="Horizontal"
                                            Margin="0,6,0,0">

                                    <TextBlock Text="{Binding VehicleCount}"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Text1}"/>

                                    <TextBlock Text=" 대"
                                               Margin="4,13,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource Text2}"/>

                                </StackPanel>

                            </StackPanel>


                            <Border Grid.Column="1"
                                    Background="{StaticResource Line}"
                                    Margin="0,4"/>


                            <StackPanel Grid.Column="2"
                                        Margin="18,0,0,0"
                                        VerticalAlignment="Center">

                                <TextBlock Text="혼잡 상태"
                                           Style="{StaticResource LabelText}"/>


                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0">

                                    <Ellipse Width="9"
                                             Height="9"
                                             Fill="#81878C"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding TrafficStatus}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text1}"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>



                <!-- SIGNAL / EMERGENCY -->

                <Border Grid.Row="2"
                        Style="{StaticResource PanelBorder}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Border Background="{StaticResource Panel2}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1">

                            <TextBlock Text="SIGNAL / EMERGENCY"
                                       Margin="15,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource TitleText}"/>

                        </Border>



                        <Grid Grid.Row="1"
                              Margin="16,11">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>



                            <Grid Grid.Row="0"
                                  Margin="0,0,0,10">

                                <TextBlock Text="현재 신호"
                                           Style="{StaticResource LabelText}"/>

                                <StackPanel HorizontalAlignment="Right"
                                            Orientation="Horizontal">

                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="#81878C"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding SignalStatus}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text1}"/>

                                </StackPanel>

                            </Grid>


                            <Border Grid.Row="1"
                                    Background="{StaticResource Line}"/>


                            <Grid Grid.Row="2"
                                  Margin="0,10">

                                <TextBlock Text="긴급차량"
                                           Style="{StaticResource LabelText}"/>

                                <TextBlock Text="{Binding EmergencyStatus}"
                                           HorizontalAlignment="Right"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text1}"/>

                            </Grid>


                            <Border Grid.Row="3"
                                    Background="{StaticResource Line}"/>


                            <Grid Grid.Row="4"
                                  Margin="0,10,0,0">

                                <TextBlock Text="신호 전환 사유"
                                           Style="{StaticResource LabelText}"/>

                                <TextBlock Text="{Binding SignalChangeReason}"
                                           HorizontalAlignment="Right"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Text1}"/>

                            </Grid>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>



        <!-- ================= EVENT LOG ================= -->

        <Border Grid.Row="2"
                Margin="22,0,22,0"
                Style="{StaticResource PanelBorder}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <Border Background="{StaticResource Panel2}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="15,0">

                        <TextBlock Text="EVENT LOG"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource TitleText}"/>

                        <TextBlock Text="최근 이벤트"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource Text2}"/>

                    </Grid>

                </Border>



                <Grid Grid.Row="1"
                      Margin="15,10">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock Text="시간"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text2}"/>

                        <TextBlock Grid.Column="1"
                                   Text="유형"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text2}"/>

                        <TextBlock Grid.Column="2"
                                   Text="이벤트 내용"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text2}"/>

                    </Grid>



                    <ListView Grid.Row="1"
                              ItemsSource="{Binding EventLogs}"
                              Background="#EFEFED"
                              BorderBrush="#D0D3D5"
                              BorderThickness="1"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="8,5">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>


                                    <TextBlock Text="{Binding Time}"
                                               FontSize="12"
                                               Foreground="{StaticResource Text2}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Type}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Text1}"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontSize="12"
                                               Foreground="{StaticResource Text1}"/>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>